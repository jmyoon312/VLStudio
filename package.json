{
  "name": "viraloop-studio",
  "version": "0.9.38",
  "buildNumber": 1022,
  "description": "ViraLoop Studio - Sovereign AI Video Production Hub from Google Flow to CapCut projects",
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "patch-electron-name": "node scripts/patch-electron-name.cjs",
    "postinstall": "node scripts/patch-electron-name.cjs",
    "predev": "node scripts/patch-electron-name.cjs",
    "dev": "vite",
    "dev:prod": "vite --mode production",
    "build": "node scripts/verify-and-build.cjs",
    "build:prod": "node scripts/verify-and-build.cjs",
    "build:dashboard": "cd apps/dashboard && npm run build",
    "build:hotpatch": "node scripts/build-hotpatch.cjs",
    "preview": "vite preview",
    "preview:dashboard": "cd apps/dashboard && npx vite preview",
    "make-ico": "node scripts/make-ico.cjs",
    "pack": "node scripts/verify-and-build.cjs && node scripts/save-build-hash.cjs",
    "dist": "npm run bump:build && npm run build:prod && electron-builder",
    "dist:mac": "npm run bump:build && npm run build:prod && electron-builder --mac",
    "dist:win": "npm run bump:build && npm run build:prod && python apps/api/dev_utils/build_backend.py && electron-builder --win",
    "dist:test": "npm run build && electron-builder",
    "dist:test:mac": "npm run build && electron-builder --mac",
    "dist:test:win": "npm run build --win",
    "mcp:install": "cd mcp-server && npm install --omit=dev",
    "bump:build": "node scripts/bump-build.cjs",
    "dist:win:nsis": "npm run bump:build && npm run mcp:install && set VITE_BUILD_TARGET=nsis&& set VITE_FUNCTION_ENV=prod&& npm run build:prod && python apps/api/dev_utils/build_backend.py && electron-builder --win nsis",
    "dist:win:appx": "npm run bump:build && npm run mcp:install && set VITE_BUILD_TARGET=appx&& set VITE_FUNCTION_ENV=prod&& npm run build:prod && scripts\\buildappx.bat",
    "dist:win:all": "npm run bump:build && npm run mcp:install && set VITE_FUNCTION_ENV=prod&& npm run build:prod && python apps/api/dev_utils/build_backend.py && electron-builder --win",
    "dist:linux": "npm run bump:build && npm run mcp:install && VITE_FUNCTION_ENV=prod npm run build:prod && electron-builder --linux",
    "dist:mac:prod": "npm run bump:build && npm run mcp:install && VITE_FUNCTION_ENV=prod npm run build:prod && electron-builder --mac",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "author": "ViraLoopMedia",
  "license": "AGPL-3.0-only",
  "private": true,
  "workspaces": [
    "apps/*",
    "mcp-server"
  ],
  "pnpm": {
    "onlyBuiltDependencies": [
      "@firebase/util",
      "@google/genai",
      "@swc/core",
      "electron",
      "electron-winstaller",
      "esbuild",
      "koffi",
      "protobufjs",
      "sharp"
    ]
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@modelcontextprotocol/sdk": "^1.27.1",
    "@openai/codex": "0.144.5",
    "@remotion/paths": "^4.0.475",
    "dotenv": "^17.3.1",
    "electron-updater": "^6.8.3",
    "firebase": "^12.9.0",
    "flag-icons": "^7.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.475"
  },
  "devDependencies": {
    "@electron/notarize": "^3.1.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^4.0.18",
    "adm-zip": "^0.6.0",
    "autoprefixer": "^10.4.16",
    "electron": "^36.9.5",
    "electron-builder": "^26.7.0",
    "jsdom": "^28.1.0",
    "png-to-ico": "^3.0.1",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.5",
    "tailwindcss-animate": "^1.0.7",
    "vite": "^6.1.0",
    "vite-plugin-electron": "^0.28.8",
    "vite-plugin-electron-renderer": "^0.14.6",
    "vitest": "^4.0.18"
  },
  "build": {
    "appId": "com.viraloopmedia.vlstudio",
    "productName": "ViraLoop Studio",
    "forceCodeSigning": false,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jmyoon312",
        "repo": "VLStudio"
      }
    ],
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "assets/**/*",
      "!assets/icon.iconset"
    ],
    "afterPack": "./scripts/afterPack.cjs",
    "extraResources": [
      {
        "from": "dist-backend/api_server.exe",
        "to": "api_server.exe"
      },
      {
        "from": "apps/api/app/legacy_ddalkkak/frontend/dist",
        "to": "legacy_ddalkkak/frontend/dist"
      },
      {
        "from": "apps/api/backend/models",
        "to": "apps/api/backend/models"
      },
      {
        "from": "mcp-server",
        "to": "mcp-server"
      },
      {
        "from": "docs",
        "to": "docs",
        "filter": [
          "csv-*.md",
          "srt-*.md",
          "audio-*.md",
          "prompt-*.md"
        ]
      },
      {
        "from": "skills",
        "to": "skills"
      },
      {
        "from": "src/config",
        "to": "src/config",
        "filter": [
          "*.json"
        ]
      }
    ],
    "afterSign": "scripts/notarize.cjs",
    "afterAllArtifactBuild": "scripts/notarize-dmg.cjs",
    "mac": {
      "icon": "assets/icon.icns",
      "target": [
        "dmg"
      ],
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "category": "public.app-category.video",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.plist"
    },
    "win": {
      "icon": "assets/icon.ico",
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "target": [
        "nsis",
        "zip"
      ]
    },
    "appx": {
      "identityName": "6129CF9F.ViraLoopStudio",
      "publisher": "CN=5939ADED-0FF9-4D26-A5D6-928AE9B2B6BC",
      "publisherDisplayName": "ViraLoopMedia",
      "languages": [
        "en-US",
        "ko-KR"
      ],
      "applicationId": "ViraLoopStudio",
      "displayName": "ViraLoop Studio",
      "backgroundColor": "transparent"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "${productName}-${version}-win-${arch}-Setup.${ext}"
    },
    "linux": {
      "icon": "assets/icon.png",
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Video",
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}"
    }
  }
}
