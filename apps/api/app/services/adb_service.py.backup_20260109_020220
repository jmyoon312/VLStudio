import subprocess
import logging
import platform
import os
import shutil
import time

logger = logging.getLogger(__name__)

class ADBService:
    def __init__(self):
        self.adb_path = "adb"
        self.target_mode = 'lte'
        # [중요] 시스템 명령어 절대 경로 (PowerShell 방해 회피)
        self.CMD_POWERSHELL = r"C:\Windows\System32\WindowsPowerShell\v1.0\powershell.exe"
        self.CMD_CURL = r"C:\Windows\System32\curl.exe"
        
        # Cache
        self._cached_ip = None
        self._cached_time = 0

        # print(f"[ADB] 서비스 초기화 완료 (PowerShell 기반 IP 추적)")

    def _get_adb_path(self): return "adb"

    def get_tethering_interface_ip(self, use_cache=True) -> str:
        """
        [핵심 로직] LTE 어댑터 IP 추출 (Caching Applied 3s)
        """
        now = time.time()
        if use_cache and self._cached_ip and (now - self._cached_time < 3):
            return self._cached_ip

        try:
            # 삼성 또는 Remote NDIS 어댑터의 IP만 추출하는 명령어
            ps_command = "Get-NetAdapter | Where-Object { $_.InterfaceDescription -like '*SAMSUNG*' -or $_.InterfaceDescription -like '*Remote NDIS*' } | Get-NetIPAddress -AddressFamily IPv4 | Select-Object -ExpandProperty IPAddress"
            
            startupinfo = subprocess.STARTUPINFO()
            startupinfo.dwFlags |= subprocess.STARTF_USESHOWWINDOW
            
            # PowerShell 실행
            result = subprocess.run(
                [self.CMD_POWERSHELL, "-Command", ps_command],
                stdout=subprocess.PIPE, stderr=subprocess.PIPE,
                text=True, startupinfo=startupinfo
            )
            
            # 반환값 정리
            if result.returncode == 0 and result.stdout:
                lines = result.stdout.strip().splitlines()
                for line in lines:
                    val = line.strip()
                    # Filter out 169.254 addresses and ensure it looks like IPv4
                    if val and "169.254" not in val and "." in val:
                        self._cached_ip = val
                        self._cached_time = now
                        return val
            
            # If not found, clear cache
            self._cached_ip = None
            return "감지되지 않음"
            
        except Exception as e:
            print(f"[ADB] IP 탐색 중 에러: {e}")
            return "Error"

    def get_current_ip(self) -> str:
        """
        [강제 바인딩]
        위에서 찾은 LTE 내부 IP(예: 10.169.195.10)를 이용해 
        curl --interface 명령어로 강제 통신합니다.
        """
        # 1. LTE 내부 IP 찾기
        local_ip = self.get_tethering_interface_ip()
        
        if local_ip in ["감지되지 않음", "Error", ""]:
            print("[ADB] ❌ LTE 어댑터 IP를 못 찾았습니다. (연결 확인 필요)")
            return "Check Failed"

        print(f"[ADB] ⚡ LTE IP 발견: {local_ip} -> 강제 바인딩 시도")
        
        # 2. 강제 바인딩 요청
        # curl.exe --interface 10.169.195.10 https://api.ipify.org
        try:
            cmd = [
                self.CMD_CURL,
                "--interface", local_ip,
                "-s", # 조용히 모드
                "--connect-timeout", "3",
                "https://api.ipify.org"
            ]
            
            startupinfo = subprocess.STARTUPINFO()
            startupinfo.dwFlags |= subprocess.STARTF_USESHOWWINDOW
            
            result = subprocess.run(
                cmd, 
                stdout=subprocess.PIPE, stderr=subprocess.PIPE, 
                text=True, startupinfo=startupinfo
            )
            
            public_ip = result.stdout.strip()
            
            # [DEBUG] 실제 응답 확인
            print(f"[ADB] 🔍 DEBUG - stdout: '{public_ip}' (len={len(public_ip)})")
            print(f"[ADB] 🔍 DEBUG - stderr: '{result.stderr.strip()}'")
            print(f"[ADB] 🔍 DEBUG - returncode: {result.returncode}")
            
            # 결과 검증
            if len(public_ip) > 6 and "." in public_ip:
                print(f"[ADB] ✅ 바인딩 성공! 공인 IP: {public_ip}")
                return public_ip
            else:
                print(f"[ADB] ❌ 바인딩 실패 (응답 없음): {result.stderr}")
                
        except Exception as e:
            print(f"[ADB] 실행 에러: {e}")

        return "확인 실패"

    # --- 기존 메서드 (호환성 유지) ---
    # --- Real Implementation of Exec ---
    def run_command(self, cmd_list):
        """
        Executes ADB command.
        """
        try:
            full_cmd = [self.adb_path] + cmd_list
            print(f"[ADB] Executing: {' '.join(full_cmd)}")
            
            startupinfo = subprocess.STARTUPINFO()
            startupinfo.dwFlags |= subprocess.STARTF_USESHOWWINDOW
            
            result = subprocess.run(
                full_cmd,
                stdout=subprocess.PIPE,
                stderr=subprocess.PIPE,
                text=True,
                startupinfo=startupinfo
            )
            
            if result.stdout:
                print(f"[ADB] stdout: {result.stdout.strip()}")
            if result.stderr:
                print(f"[ADB] stderr: {result.stderr.strip()}")
            
            print(f"[ADB] Command completed with return code: {result.returncode}")
            return result.stdout.strip()
        except Exception as e:
            print(f"[ADB] Command Failed {cmd_list}: {e}")
            return ""

    def rotate_ip(self, method='soft'):
        """
        Soft: Data Toggle (Fast)
        Hard: Airplane Mode (Deep reset)
        """
        print(f"[ADB] ========== IP ROTATION START (Method: {method}) ==========")
        try:
            if method == 'soft':
                # Optimized Soft Rotation: Just toggle data via svc (Fastest)
                print("[ADB] ⚡ Quick Data Toggle...")
                self.run_command(['shell', 'svc', 'data', 'disable'])
                time.sleep(0.5) # Increased to 0.5s for modem stability
                self.run_command(['shell', 'svc', 'data', 'enable'])

            else:
                # Hard / Airplane Mode
                print("[ADB] Step 1: Enabling airplane mode...")
                self.run_command(['shell', 'cmd', 'connectivity', 'airplane-mode', 'enable'])
                
                print("[ADB] Waiting 1 second...")
                time.sleep(1)
                
                print("[ADB] Step 2: Disabling airplane mode...")
                self.run_command(['shell', 'cmd', 'connectivity', 'airplane-mode', 'disable'])
            
            print(f"[ADB] ========== IP ROTATION COMPLETE ==========")
            return True
        except Exception as e:
            print(f"[ADB] Rotation Error: {e}") 
            return False

# Create Singleton
adb_service = ADBService()