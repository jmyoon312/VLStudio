# --- Sovereign Swarm Agent (apps/swarm) ---
FROM node:24-bookworm-slim

WORKDIR /app

# Install system dependencies if needed (e.g., for browser automation)
RUN apt-get update && apt-get install -y \
    curl \
    gnupg \
    && rm -rf /var/lib/apt/lists/*

# Install dependencies
COPY apps/swarm/package*.json ./
RUN npm install

# Copy source code
COPY apps/swarm/ .

# Expose the port defined in docker-compose
EXPOSE 4000

# Start the agent
CMD ["npm", "start"]
